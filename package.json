{
  "name": "buildison",
  "version": "0.7.2",
  "description": "Toolbox de agentes de código (AGENTS.md + MCP) — instalador multi-agente: Claude Code, Codex, OpenCode/Hermes, Antigravity",
  "bin": {
    "buildison": "bin/buildison.mjs"
  },
  "type": "module",
  "files": [
    "bin/",
    "install.sh",
    "install.ps1",
    "switch.sh",
    "switch.ps1",
    "AGENTS.md",
    "docs/infra/*-template.md",
    "CLAUDE.md",
    ".claude/",
    ".agents/",
    "scripts/gen-antigravity.mjs",
    "docs/agent/",
    ".spec-workflow/templates/"
  ],
  "scripts": {
    "install:local": "bash install.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "agents",
    "mcp",
    "agents.md",
    "boilerplate"
  ],
  "license": "MIT"
}
